<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.skybooker</groupId>
    <artifactId>skybooker-aggregator</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>SkyBooker Aggregator</name>
    <description>Aggregator POM for SkyBooker Microservices</description>

    <properties>
        <sonar.organization>adityanarayangupta2004</sonar.organization>
        <!-- Final SonarCloud optimization complete -->
        <sonar.projectKey>AdityaNarayanGupta2004_SkyBooker</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        
        <!-- Coverage and Exclusions -->
        <sonar.coverage.jacoco.xmlReportPaths>
            airline-service/target/site/jacoco/jacoco.xml,
            api-gateway/target/site/jacoco/jacoco.xml,
            auth-service/target/site/jacoco/jacoco.xml,
            flight-booking/target/site/jacoco/jacoco.xml,
            flight-service/target/site/jacoco/jacoco.xml,
            passenger-service/target/site/jacoco/jacoco.xml,
            payment-service/target/site/jacoco/jacoco.xml,
            seat-service/target/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>

        <sonar.exclusions>
            **/dto/**,
            **/entity/**,
            **/config/**,
            **/exception/**,
            **/payload/**,
            **/*Application.java,
            **/security/**,
            **/*Controller.java,
            **/repository/**,
            api-gateway/**
        </sonar.exclusions>

        <sonar.cpd.exclusions>
            **/dto/**,
            **/entity/**,
            **/config/**,
            **/security/**
        </sonar.cpd.exclusions>
    </properties>

    <modules>
        <module>airline-service</module>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>flight-booking</module>
        <module>flight-service</module>
        <module>passenger-service</module>
        <module>payment-service</module>
        <module>seat-service</module>
    </modules>

</project>
